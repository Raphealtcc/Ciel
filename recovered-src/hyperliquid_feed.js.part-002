        }
      }
    }
    if (Date.now() - this.lastTickAt > PRICE_STALE_MS) {
      await this.refreshFromRest().catch((error) => {
        this.lastError = "Hyperliquid REST mid fallback failed: " + String(error).slice(0, 250);
        void this.state.storage.put("lastError", this.lastError).catch(() => void 0);
      });
    }
    await this.checkOpenPositions(Date.now());
    await this.scheduleNextAlarm();
  }
  async scheduleAlarm(delayMs) {
    try {
      await this.state.storage.setAlarm(Date.now() + delayMs);
    } catch (error) {
      this.lastError = "Alarm scheduling failed: " + String(error).slice(0, 250);
      console.error(this.lastError);
    }
  }
  async scheduleNextAlarm() {
    let delay = this.socket && this.socket.readyState === WebSocket.CONNECTING ? 5e3 : HEARTBEAT_INTERVAL_MS;
    try {
      const active = await this.env.DB.prepare(
        "SELECT 1 AS active FROM advisor_positions WHERE status='OPEN' LIMIT 1"
      ).first();
      if (active) delay = POSITION_CHECK_INTERVAL_MS;
      const paperState = await this.state.storage.get(PAPER_ACCOUNT_KEY);
      if ((paperState?.trades || []).some((trade) => trade.status === "OPEN")) delay = POSITION_CHECK_INTERVAL_MS;
    } catch (error) {
      console.error("Could not inspect active advisor positions for alarm cadence: " + String(error).slice(0, 200));
    }
    await this.scheduleAlarm(delay);
  }
