;
        return;
      }
      try {
        socket.send(JSON.stringify({ method: "ping" }));
        this.lastPingAt = now;
      } catch (error) {
        this.connected = false;
        this.lastError = "Hyperliquid heartbeat send failed: " + String(error).slice(0, 180);
        void this.state.storage.put("lastError", this.lastError).catch(() => void 0);
        try {
          socket.close();
