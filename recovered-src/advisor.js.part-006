      side: params.side === "SHORT" ? "SHORT" : "LONG",
      mode: params.mode === "RANGE_SCALP" ? "RANGE_SCALP" : "TREND_HOLD",
      regime: String(params.regime || ""),
      maxMarketLeverage: maxLeverage, leverage: PAPER_LEVERAGE, marginMon: margin,
