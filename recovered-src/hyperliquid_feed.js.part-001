  async fetch(request) {
    await this.ready;
    const path = new URL(request.url).pathname;
    if (path === "/leverup/native-samples" && request.method === "POST") {
      try {
        const body = await request.json();
        const sampleAt = Number(body?.sampleAt);
        const rows = Array.isArray(body?.rows) ? body.rows : [];
        if (!Number.isFinite(sampleAt) || sampleAt <= 0 || rows.length < 1 || rows.length > 100) {
          return json({ ok: false, error: "LEVERUP_NATIVE_SAMPLE_PAYLOAD_INVALID" }, 400);
        }
        const cache = await this.state.storage.get("leverupNativeSamples") || { lastSampleAt: 0, samples: {} };
        if (!cache.samples || typeof cache.samples !== "object" || Array.isArray(cache.samples)) cache.samples = {};
        if (sampleAt > Number(cache.lastSampleAt || 0)) {
          for (const raw of rows) {
            const symbol = String(raw?.symbol || "").trim().toUpperCase();
            const pairBase = String(raw?.pair_base || "").toLowerCase();
            const price = Number(raw?.price);
            if (!/^[A-Z0-9._-]{1,24}$/.test(symbol) || !/^0x[0-9a-f]{40}$/.test(pairBase) || !Number.isFinite(price) || price <= 0) {
              return json({ ok: false, error: "LEVERUP_NATIVE_SAMPLE_ROW_INVALID" }, 400);
            }
            const series = Array.isArray(cache.samples[symbol]) ? cache.samples[symbol] : [];
