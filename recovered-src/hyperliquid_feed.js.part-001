            const existingIndex = series.findIndex((item) => Number(item?.observed_at_ms) === sampleAt);
            if (existingIndex >= 0) series[existingIndex] = next;
            else series.push(next);
            cache.samples[symbol] = series
              .filter((item) => Number(item?.observed_at_ms) > sampleAt - 3 * 60 * 60 * 1000)
              .sort((a, b) => Number(a.observed_at_ms) - Number(b.observed_at_ms))
              .slice(-180);
          }
          cache.lastSampleAt = sampleAt;
          await this.state.storage.put("leverupNativeSamples", cache);
        }
        return json({ ok: true, sampledAt: Number(cache.lastSampleAt || 0), samples: cache.samples });
      } catch (error) {
        console.error("LeverUp native sample DO storage failed: " + String(error).slice(0, 180));
