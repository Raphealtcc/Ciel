async function getCandleStructureMap(env,symbols,now){
  const unique=[...new Set(symbols)].filter(Boolean);
  if(!unique.length)return new Map();
  try{
    const marks=unique.map(()=>"?").join(",");
    const hour=Math.floor(now/36e5)*36e5,dayStart=now-24*36e5;
    const result=await env.DB.prepare(
      "SELECT symbol,MIN(low_price) AS dayLow,MAX(high_price) AS dayHigh,"+
      "MIN(CASE WHEN bucket_ms>=? THEN low_price END) AS currentHourLow,"+
      "MAX(CASE WHEN bucket_ms>=? THEN high_price END) AS currentHourHigh,"+
      "MIN(CASE WHEN bucket_ms>=? AND bucket_ms<? THEN low_price END) AS priorHourLow,"+
      "MAX(CASE WHEN bucket_ms>=? AND bucket_ms<? THEN high_price END) AS priorHourHigh,"+
      "MAX(bucket_ms) AS latestBucket,COUNT(*) AS buckets FROM market_candle_hourly_stats "+
      "WHERE symbol IN ("+marks+") AND bucket_ms>=? AND bucket_ms<=? GROUP BY symbol"
    ).bind(hour,hour,hour-36e5,hour,hour-36e5,hour,...unique,dayStart,hour).all();
    return new Map((result.results||[]).map(row=>[String(row.symbol).toUpperCase(),row]));
  }catch(error){console.error("Candle structure batch read failed: "+String(error).slice(0,180));return new Map();}
}
