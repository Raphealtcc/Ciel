  else if(highHit.length&&r3<=-0.035&&r5<=-0.025){side="SHORT";hit=highHit.sort((a,b)=>Math.abs(last.p/a[1]-1)-Math.abs(last.p/b[1]-1))[0];}
  if(!side)return null;
