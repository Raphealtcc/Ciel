  return {symbol,side,entry:last.p,stopPct,targetPct,confidence,scoreComponents:[hit[0]+"_SWEEP","LEVEL_RECLAIM","3M_REVERSAL","5M_CONFIRMATION"],scoreModel:"multi-market-hourly-level-reversal-v1",strategy:"MULTI_MARKET_LEVEL_SWEEP_RECLAIM",regime:"LEVEL_REVERSAL",mode:"RANGE_SCALP",holdMinutes:15,rsi:null,bounce:null,cci:null,stochRsi:null,rangePositionPct:null,reason:side+" reclaimed "+hit[0].replaceAll("_"," ")+" at "+level+" after a sweep; 3m return "+r3.toFixed(3)+"%, 5m return "+r5.toFixed(3)+"%. Uses stored Hyperliquid hourly aggregates across the configured watchlist."};
}
