    if(Number(geminiCooldown.untilMs)>now)return active;
    await env.CIEL_STATE.put(scanKey,JSON.stringify({lastSearchAt:now,lastBtcPrice:pulse.btcPrice,triggerReason:pulse.triggerReason}),{expirationTtl:86400});
    try{
      const url=new URL("https://api.gdeltproject.org/api/v2/doc/doc");
      url.searchParams.set("query",'(Binance OR cryptocurrency OR crypto OR Bitcoin OR Ethereum OR stablecoin OR exchange OR "digital ass