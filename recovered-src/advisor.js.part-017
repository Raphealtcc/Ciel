    const inserted = await env.DB.prepare("INSERT INTO advisor_positions(id,symbol,side,entry_price,stop_price,target_price,stop_pct,target_pct,confidence,strategy,rationale,status,created_at_ms,expires_at_ms,mon_collateral,leverage,entry_mon_usd,updated_at_ms) VALUES(?,?,?,?,?,?,?,?,?,?,?,'PROPOSED',?,?,?,?,?,?)").bind(id, candidate.symbol, candidate.side, candidate.entry, stop, target, candidate.stopPct, candidate.targetPct, candidate.confidence, candidate.strategy, rationale, now, expires, collateral, leverage, prices.MON, now).run();
