    try {
      const response = await fetch(HYPERLIQUID_INFO, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ type: "allMids" }),
        signal: AbortSignal.timeout(1e4)
      });
      if (!response.ok) throw new Error("allMids REST returned HTTP " + response.status);
      const mids = await response.json();
      const watch = new Set(this.watchlist());
      const next = {};
      for (const [rawSymbol, rawPrice] of Object.entries(mids)) {
        const symbol = rawSymbol.trim().toUpperCase();
        const value = Number(rawPrice);
        if (watch.has(symbol) && Number.isFinite(value) && value > 0) next[symbol] = value;
      }
      if (!Object.keys(next).length) throw new Error("allMids REST returned no watched symbols");
      this.latest = next;
      this.lastTickAt = Date.now();
      await this.checkOpenPositions(this.lastTickAt);
      if (this.lastSampleAt === 0 || this.lastTickAt - this.lastSampleAt >= SAMPLE_INTERVAL_MS) {
        this.lastSampleAt = this.lastTickAt;
        await this.samplePrices(this.lastSampleAt);
      }
    } finally {
      this.restRefreshInProgress = false;
    }
  }
