G SOURCES (headlines only)"
  ];
  for(const article of event.articles.slice(0,4))lines.push("- "+article.domain+": "+article.title+" "+article.url);
  lines.push("","This is a risk warning, not a short entry. CIEL still requires technical, forecast and liquidity confirmation. Read-only advisory; no orders are executed.");
  try{
    await sendTelegram(env,lines.join("\n"));
    event.notifiedAt=Date.now();
    await env.CIEL_STATE.put(activeKey,JSON.stringify(event),{expirationTtl:7200});
  }catch(error){console.error("CIEL event alert Telegram delivery failed: "+String(error).slice(0,180));}
  return event;
}

