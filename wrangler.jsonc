{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production replacement Worker. The attached D1/KV resources remain isolated paper/staging datasets.
  "name": "ciel2",
  "main": "reconstructed/patched-worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PAPER_TRADING_ENABLED": "false",
    "ADVISORY_MIN_CONFIDENCE": "0.72",
    "ADVISORY_TREND_REVIEW_COOLDOWN_MINUTES": "30",
    "ALERT_COOLDOWN_MINUTES": "15",
    "ALERT_WINDOW_MINUTES": "5",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
      "LEVERUP_AUTO_APPROVE": "true",
    "MOVE_ALERT_PCT": "2.0",
    "TELEGRAM_STAGING_BOT_ID": "9190238402",
    "TELEGRAM_WEBHOOK_URL": "https://ciel2.gatakehanami.workers.dev/telegram/webhook",
    "WATCH_SYMBOLS": "BTC,ETH,MON,BNB,XRP,HYPE,ONDO,KPEPE,QNT,ZEC,TRX,AAVE,ADA,CASHCAT,DOGE,LINK,LIT,PONS,PUMP,SEI,SOL,SUI,UNI,VIRTUAL,XMR",
    "LEVERUP_TRADER_ADDRESS": "0xd422fc040ad9294d553150Cf5646Ab0B1729E443",
    "LEVERUP_AGENT_ADDRESS": "0x77DF3ae15b994131797905e59675da3544C90DFF",
    "LEVERUP_PREFLIGHT_ENABLED": "true",
    "LEVERUP_LIVE_TRADING": "false",
    "LEVERUP_PURGE_LIVE_ENABLED": "true",
    "LEVERUP_KILL_SWITCH": "true",
    "LEVERUP_MIN_LEVERAGE": "50",
    "LEVERUP_TOTAL_ALLOCATION_MON": "50",
    "LEVERUP_RESERVE_MON": "25",
    "LEVERUP_MAX_TRADE_MARGIN_MON": "25",
    "LEVERUP_MAX_CONCURRENT_POSITIONS": "1",
    "LEVERUP_MAX_DAILY_LOSS_MON": "9",
    "LEVERUP_MAX_DRAWDOWN_MON": "9",
    "LEVERUP_MAX_AGGREGATE_STOP_RISK_MON": "6",
    "LEVERUP_COLLATERAL_100X_USD": "0.23",
    "LEVERUP_COLLATERAL_50X_USD": "0.43"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ciel-paper-staging",
    "database_id": "a41e95fe-58cc-443a-839e-5ee0525e9fcf"
  }],
  "kv_namespaces": [{
    "binding": "CIEL_STATE",
    "id": "6e1fa505914c4d3b87b5b49c9d54f6fe"
  }],
  "previews": {
    // Preview settings do not inherit top-level vars or bindings.
    // Branch previews intentionally share the isolated staging D1/KV dataset.
    "vars": {
      "PAPER_TRADING_ENABLED": "false",
      "ADVISORY_MIN_CONFIDENCE": "0.72",
      "ADVISORY_TREND_REVIEW_COOLDOWN_MINUTES": "30",
      "ALERT_COOLDOWN_MINUTES": "15",
      "ALERT_WINDOW_MINUTES": "5",
      "GEMINI_MODEL": "gemini-3.5-flash-lite",
      "LEVERUP_AUTO_APPROVE": "true",
      "MOVE_ALERT_PCT": "2.0",
      "TELEGRAM_WEBHOOK_URL": "",
      "TELEGRAM_STAGING_BOT_ID": "",
      "WATCH_SYMBOLS": "BTC,ETH,MON,BNB,XRP,HYPE,ONDO,KPEPE,QNT,ZEC,TRX,AAVE,ADA,CASHCAT,DOGE,LINK,LIT,PONS,PUMP,SEI,SOL,SUI,UNI,VIRTUAL,XMR",
      "LEVERUP_TRADER_ADDRESS": "0xd422fc040ad9294d553150Cf5646Ab0B1729E443",
      "LEVERUP_AGENT_ADDRESS": "0x77DF3ae15b994131797905e59675da3544C90DFF",
      "LEVERUP_PREFLIGHT_ENABLED": "true",
      "LEVERUP_LIVE_TRADING": "false",
      "LEVERUP_PURGE_LIVE_ENABLED": "false",
      "LEVERUP_KILL_SWITCH": "true",
      "LEVERUP_MIN_LEVERAGE": "50",
      "LEVERUP_TOTAL_ALLOCATION_MON": "50",
      "LEVERUP_RESERVE_MON": "25",
      "LEVERUP_MAX_TRADE_MARGIN_MON": "25",
      "LEVERUP_MAX_CONCURRENT_POSITIONS": "1",
      "LEVERUP_MAX_DAILY_LOSS_MON": "9",
      "LEVERUP_MAX_DRAWDOWN_MON": "9",
      "LEVERUP_MAX_AGGREGATE_STOP_RISK_MON": "6",
      "LEVERUP_COLLATERAL_100X_USD": "0.23",
      "LEVERUP_COLLATERAL_50X_USD": "0.43"
    },
    "d1_databases": [{
      "binding": "DB",
      "database_name": "ciel-paper-staging",
      "database_id": "a41e95fe-58cc-443a-839e-5ee0525e9fcf"
    }],
    "kv_namespaces": [{
      "binding": "CIEL_STATE",
      "id": "6e1fa505914c4d3b87b5b49c9d54f6fe"
    }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HYPERLIQUID_FEED", "class_name": "HyperliquidFeed" },
      { "name": "TRADING_ENGINE", "class_name": "TradingEngine" }
    ]
  },
  "exports": {
    "HyperliquidFeed": { "type": "durable-object", "storage": "sqlite" },
    "TradingEngine": { "type": "durable-object", "storage": "sqlite" }
  }
}